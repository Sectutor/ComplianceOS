# =============================================================================
# COMPLIANCEOS ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://user:password@host:5432/complianceos?sslmode=require"

# -----------------------------------------------------------------------------
# REQUIRED - Supabase Configuration
# -----------------------------------------------------------------------------
# Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Anonymous key (safe for client-side use)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Service role key - ONLY for server-side operations
# WARNING: Never expose this key in client-side code
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# REQUIRED - Application URLs
# -----------------------------------------------------------------------------
# Full URL of the application (used for email links, redirects)
NEXT_PUBLIC_APP_URL="https://app.complianceos.com"
VITE_APP_URL="https://app.complianceos.com"

# Server URL for API callbacks
APP_URL="https://app.complianceos.com"

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------
PORT=3001

# CORS - Allowed origins (comma-separated for multiple)
CORS_ORIGIN="https://app.complianceos.com,http://localhost:5173"

# -----------------------------------------------------------------------------
# OPTIONAL - Security Features
# -----------------------------------------------------------------------------
# Enable rate limiting ('true' to enable)
RATE_LIMITING_ENABLED="true"

# Rate limit: maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit: window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Enable premium features ('false' to disable for community edition)
VITE_ENABLE_PREMIUM="true"

# Application mode: 'production', 'development', or 'demo'
VITE_APP_MODE="production"

# -----------------------------------------------------------------------------
# OPTIONAL - Third-Party Integrations
# -----------------------------------------------------------------------------
# OpenAI API Key (for AI features)
# OPENAI_API_KEY="sk-..."

# SendGrid API Key (for email)
# SENDGRID_API_KEY="SG..."

# AWS Access Key (for S3 uploads)
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# -----------------------------------------------------------------------------
# OPTIONAL - Encryption
# -----------------------------------------------------------------------------
# Secret key for encrypting sensitive data at rest
# ENCRYPTION_KEY="your-32-character-encryption-key"

# JWT Secret for token validation
# JWT_SECRET="your-jwt-secret-key"

# -----------------------------------------------------------------------------
# OPTIONAL - Performance & Debugging
# -----------------------------------------------------------------------------
# Enable verbose authentication debug logging ('true' to enable)
# DEBUG_AUTH="false"

# Number of concurrent policy generation requests (default: 3)
# Increase for faster bulk operations, decrease if LLM API rate limits are hit
# POLICY_GENERATION_CONCURRENCY="3"

# -----------------------------------------------------------------------------
# SELF-HOST TRANSFORMATION (Phase 1-5)
# -----------------------------------------------------------------------------

# Encryption key for credentials at rest (REQUIRED in production)
APP_ENCRYPTION_KEY="your-32-char-min-key-here"

# License key for premium tier
VITE_LICENSE_KEY=""
VITE_ENABLE_PREMIUM="true"
VITE_LICENSE_SERVER="https://license.complianceos.com"

# Telemetry control (set to true for air-gapped deployments)
NO_TELEMETRY="false"
ENABLE_AI="false"
ENABLE_THREAT_SCHEDULER="false"

# Email transport (Resend or SMTP)
# RESEND_API_KEY="re_xxxx"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="pass"
EMAIL_FROM="noreply@complianceos.com"

# Auth mode: 'auto' (default, tries Supabase falls back to local), 'local' (force local), 'supabase'
AUTH_MODE="auto"

# API key for Hermes compliance-agent to access the REST API
COMPLIANCE_API_KEY="change-me-to-a-random-64-char-key"

# Admin credentials for first-run local auth
COMPLIANCE_ADMIN_EMAIL="admin@complianceos.local"
# COMPLIANCE_ADMIN_PASSWORD="auto-generated-on-first-run"

# Cloud provider LLM key for the compliance agent
# DEEPSEEK_API_KEY="sk-..."

# Telegram bot token (Pro+ tier)
# TELEGRAM_BOT_TOKEN=""

# Slack bot credentials (Pro+ tier)
# SLACK_BOT_TOKEN=""
# SLACK_SIGNING_SECRET=""

# CISOvault integration (optional)
# CISOVAULT_API_URL="http://cisovault:3099"
# CISOVAULT_API_KEY=""

# -----------------------------------------------------------------------------
# REQUIRED FOR PAYMENTS - Stripe
# -----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_xxxxx"   # or sk_live_ in production
# STRIPE_WEBHOOK_SECRET="whsec_xxxxx"  # from Stripe Dashboard → Webhooks
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
# VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"

# Stripe Price IDs — run scripts/setup-stripe.py to generate these
# Or create them manually in Stripe Dashboard → Products
#
# Pro tier ($49/mo | $499/yr):
# STRIPE_PRICE_STARTUP_MONTHLY="price_xxxxx"
# STRIPE_PRICE_STARTUP_YEARLY="price_xxxxx"
#
# MSSP tier ($99/mo | $999/yr):
# STRIPE_PRICE_GUIDED_MONTHLY="price_xxxxx"
# STRIPE_PRICE_GUIDED_YEARLY="price_xxxxx"
#
# Enterprise tier ($4,990/yr):
# STRIPE_PRICE_MANAGED="price_xxxxx"

# Enable billing (set to 'true' to expose checkout/pricing UI)
# VITE_ENABLE_BILLING="true"
# ENABLE_BILLING="true"

# OIDC / SSO
# OIDC_ISSUER="https://idp.example.com/realms/complianceos"
# OIDC_CLIENT_ID="complianceos"
# OIDC_CLIENT_SECRET="***"

# Cache directory for license and local data
# COMPLIANCEOS_DATA_DIR="/var/lib/complianceos"
