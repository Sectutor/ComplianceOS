{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ComplianceOS Framework Plugin",
    "type": "object",
    "required": [
        "manifest",
        "content"
    ],
    "properties": {
        "manifest": {
            "type": "object",
            "required": [
                "id",
                "slug",
                "name",
                "version",
                "author",
                "description",
                "type"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "author": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "General",
                        "Security",
                        "Privacy",
                        "Federal",
                        "Strategic",
                        "Quality"
                    ]
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "icon": {
                    "type": "string"
                },
                "minAppVersion": {
                    "type": "string"
                }
            }
        },
        "content": {
            "type": "object",
            "required": [
                "phases",
                "requirements"
            ],
            "properties": {
                "phases": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "order"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "order": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "requirements": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "identifier",
                            "title",
                            "description"
                        ],
                        "properties": {
                            "identifier": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "guidance": {
                                "type": "string"
                            },
                            "phaseName": {
                                "type": "string"
                            },
                            "mappingTags": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "policies": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "content"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "content": {
                                "type": "string"
                            },
                            "mappedControls": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "risks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "title",
                            "inherentRisk"
                        ],
                        "properties": {
                            "title": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "inherentRisk": {
                                "type": "string",
                                "enum": [
                                    "Low",
                                    "Medium",
                                    "High",
                                    "Critical"
                                ]
                            },
                            "mappedControls": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}