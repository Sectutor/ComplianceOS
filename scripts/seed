
import * as dotenv from 'dotenv';
import path from 'path';
dotenv.config({ path: path.resolve(process.cwd(), '.env') });
import { getDb } from "../db";
import { clientPolicies, riskAssessments, clientControls, controls } from "../schema";
import { subDays } from "date-fns";

async function seedTestData(clientId: number) {
    const db = await getDb();
    console.log(`--- Seeding Autopilot Test Data for Client ${clientId} ---`);

    // 1. Stale Policy (Approved)
    await db.insert(clientPolicies).values({
        clientId,
        name: "Legacy Access Control Policy (Test)",
        description: "Policy that hasn't been updated in over a year.",
        status: 'approved',
        version: 1,
        content: "Policy content...",
        createdAt: subDays(new Date(), 400),
        updatedAt: subDays(new Date(), 400),
    });
    console.log("Created: Stale Policy (Approved)");

    // 2. Stale Policy (Draft)
    await db.insert(clientPolicies).values({
        clientId,
        name: "Old Draft Incident Response (Test)",
        description: "Draft policy abandoned a year ago.",
        status: 'draft',
        version: 1,
        content: "Draft content...",
        createdAt: subDays(new Date(), 380),
        updatedAt: subDays(new Date(), 380),
    });
    console.log("Created: Stale Policy (Draft)");

    // 3. Critical Risk (Score 20)
    await db.insert(riskAssessments).values({
        clientId,
        assessmentId: "RA-TEST-001",
        title: "Critical Database Exposed (Test)",
        description: "Test risk with high residual score.",
        status: 'approved',
        inherentScore: 25,
        residualScore: 20, // > 14
        category: 'Technical',
        owner: 'Security Team'
    });
    console.log("Created: Critical Risk (Score 20)");

    // 4. High Risk (Score 16)
    await db.insert(riskAssessments).values({
        clientId,
        assessmentId: "RA-TEST-002",
        title: "Vendor Contract Gap (Test)",
        description: "Test risk with high residual score.",
        status: 'approved',
        inherentScore: 20,
        residualScore: 16, // > 14
        category: 'Legal',
        owner: 'Legal Team'
    });
    console.log("Created: High Risk (Score 16)");

    // 5. Overdue Control
    const anyControl = await db.select().from(controls).limit(1);
    let targetControlId = 1;

    if (anyControl.length > 0) {
        targetControlId = anyControl[0].id;
    } else {
        const [newControl] = await db.insert(controls).values({
            controlId: "TEST-001",
            name: "Test Control",
            framework: "NIST",
            version: 1
        }).returning();
        targetControlId = newControl.id;
    }

    await db.insert(clientControls).values({
        clientId,
        controlId: targetControlId,
        clientControlId: "TEST-001-C",
        customDescription: "Control implementation is overdue.",
        status: 'in_progress',
        dueDate: subDays(new Date(), 5), // Due 5 days ago
        owner: 'Compliance Manager'
    });
    console.log(`Created: Overdue Control (Linked to Control ID ${targetControlId})`);

    console.log("--- Seeding Complete ---");
}

seedTestData(3).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); });
