
import * as dotenv from 'dotenv';
import path from 'path';
dotenv.config({ path: path.resolve(process.cwd(), '.env') });
import { getDb } from "../db";
import { clientPolicies, riskAssessments, clientControls, workItems } from "../schema";
import { eq, and, gt, lt, or, not } from "drizzle-orm";
import { subDays } from "date-fns";

async function genericDebug(clientId: number) {
    const db = await getDb();
    console.log(`--- Debugging Autopilot Data for Client ${clientId} ---`);
    console.log(`Current Time: ${new Date().toISOString()}`);

    // 1. Check Policies
    const oneYearAgo = subDays(new Date(), 365);
    const policies = await db.select().from(clientPolicies).where(eq(clientPolicies.clientId, clientId));

    console.log(`\n[Policies] Total: ${policies.length}`);
    policies.forEach(p => {
        const isStale = new Date(p.updatedAt!) < oneYearAgo;
        console.log(` - ID ${p.id} "${p.name}": Status=${p.status}, Updated=${p.updatedAt?.toISOString()} (Stale: ${isStale})`);
    });

    // 2. Check Risks
    const risks = await db.select().from(riskAssessments).where(eq(riskAssessments.clientId, clientId));
    console.log(`\n[Risks] Total: ${risks.length}`);
    risks.forEach(r => {
        const isHigh = (r.residualScore || 0) > 14;
        const isDraft = r.status === 'draft';
        console.log(` - ID ${r.id} "${r.title}": Score=${r.residualScore}, Status=${r.status} (Candidate: ${isHigh && !isDraft})`);
    });

    // 3. Check Controls
    const now = new Date();
    const controls = await db.select().from(clientControls).where(eq(clientControls.clientId, clientId));
    console.log(`\n[Controls] Total: ${controls.length}`);
    let cCount = 0;
    controls.forEach(c => {
        const isOverdue = c.dueDate ? new Date(c.dueDate) < now : false;
        const isIncomplete = c.status === 'not_implemented' || c.status === 'in_progress';
        if (isOverdue && isIncomplete) {
            console.log(` - ID ${c.id} "${c.controlId}": Status=${c.status}, Due=${c.dueDate} (Candidate: YES)`);
            cCount++;
        }
    });
    console.log(`[Controls] Candidates found: ${cCount}`);

    // 4. Check Existing WorkItems
    const items = await db.select().from(workItems).where(eq(workItems.clientId, clientId));
    console.log(`\n[WorkItems] Total: ${items.length}`);
    items.forEach(w => {
        console.log(` - ID ${w.id}: Type=${w.entityType}/${w.entityId}, Status=${w.status}, Title="${w.title}"`);
    });
}

genericDebug(3).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); });
