/**
 * Manual Test Script for AI Features
 * Run with: npx tsx scripts/test-ai-features.ts
 */

import 'dotenv/config';
import { getDb } from '../db';
import { sql } from 'drizzle-orm';

import { extractEvidenceMetadata, suggestEvidenceTypes } from '../lib/evidence/extraction';
import { policyGenerator } from '../lib/policy/policy-generation';
import { searchSimilar } from '../lib/advisor/retrieval';
import { llmService } from '../lib/llm/service';
import { checkAIQuota } from '../lib/limits';

async function testEvidenceExtraction() {
    console.log('\n🧪 Testing Evidence Extraction...');

    try {
        const result = await extractEvidenceMetadata({
            fileName: 'mfa-config.json',
            fileType: 'application/json',
            textContent: JSON.stringify({
                mfa: {
                    enabled: true,
                    method: 'totp',
                    enforced: true,
                },
            }),
            controlContext: {
                controlId: 'AC-2',
                controlName: 'Account Management',
                framework: 'NIST 800-53',
            },
        });

        console.log('✅ Evidence extracted successfully:');
        console.log('   Classification:', result.classification);
        console.log('   Summary:', result.summary);
        console.log('   Key Findings:', result.keyFindings.join(', '));
        console.log('   Confidence:', result.confidence);
    } catch (error: any) {
        console.error('❌ Evidence extraction failed:', error.message);
    }
}

async function testEvidenceSuggestions() {
    console.log('\n🧪 Testing Evidence Suggestions...');

    try {
        const suggestions = await suggestEvidenceTypes(
            'AC-2',
            'Account Management',
            'NIST 800-53'
        );

        console.log('✅ Evidence suggestions generated:');
        suggestions.forEach((s, i) => console.log(`   ${i + 1}. ${s}`));
    } catch (error: any) {
        console.error('❌ Evidence suggestions failed:', error.message);
    }
}

async function testPolicyGeneration() {
    console.log('\n🧪 Testing Policy Generation...');

    try {
        const sections = await policyGenerator.suggestSections(
            'Remote Work Policy',
            'Technology'
        );

        console.log('✅ Policy sections suggested:');
        sections.forEach((s, i) => console.log(`   ${i + 1}. ${s}`));

        // Test section generation
        const content = await policyGenerator.generateFromSections(
            1, // clientId
            'Remote Work Policy',
            sections.slice(0, 3), // First 3 sections
            { language: 'en' }
        );

        console.log('\n✅ Policy content generated:');
        console.log('   Length:', content.length, 'characters');
        console.log('   Preview:', content.substring(0, 200) + '...');
    } catch (error: any) {
        console.error('❌ Policy generation failed:', error.message);
    }
}

async function testRAGRetrieval() {
    console.log('\n🧪 Testing RAG Retrieval...');

    try {
        const results = await searchSimilar(
            'multi-factor authentication access control',
            {
                limit: 5,
                threshold: 0.5,
                docTypes: ['control'],
            }
        );

        console.log('✅ RAG retrieval completed:');
        console.log('   Found:', results.length, 'results');
        results.forEach((r, i) => {
            console.log(`   ${i + 1}. ${r.docId} (${r.docType}) - Similarity: ${r.similarity.toFixed(3)}`);
            console.log(`      ${r.content.substring(0, 100)}...`);
        });
    } catch (error: any) {
        console.error('❌ RAG retrieval failed:', error.message);
    }
}

async function testQuotaLimits() {
    console.log('\n🧪 Testing Quota Limits...');

    try {
        const quota = await checkAIQuota(1, 'testEndpoint');

        console.log('✅ Quota check completed:');
        console.log('   Allowed:', quota.allowed);
        console.log('   Usage:');
        console.log('     - Requests this hour:', quota.usage.requestsThisHour);
        console.log('     - Requests today:', quota.usage.requestsToday);
        console.log('     - Tokens today:', quota.usage.tokensToday);
        console.log('     - Cost today: $' + (quota.usage.costTodayCents / 100).toFixed(2));
        console.log('   Limits:');
        console.log('     - Requests/hour:', quota.limits.requestsPerHour);
        console.log('     - Requests/day:', quota.limits.requestsPerDay);
        console.log('     - Tokens/day:', quota.limits.tokensPerDay);
    } catch (error: any) {
        console.error('❌ Quota check failed:', error.message);
    }
}

async function testLLMService() {
    console.log('\n🧪 Testing LLM Service...');

    try {
        const response = await llmService.generate({
            systemPrompt: 'You are a helpful compliance assistant.',
            userPrompt: 'What is the purpose of ISO 27001?',
            temperature: 0.7,
            maxTokens: 100,
        });

        console.log('✅ LLM generation completed:');
        console.log('   Provider:', response.provider);
        console.log('   Model:', response.model);
        console.log('   Response:', response.text.substring(0, 200));
        if (response.usage) {
            console.log('   Tokens:', response.usage.totalTokens);
        }
    } catch (error: any) {
        console.error('❌ LLM generation failed:', error.message);
    }
}

async function testStreamingLLM() {
    console.log('\n🧪 Testing LLM Streaming...');

    try {
        const stream = llmService.generateStream({
            systemPrompt: 'You are a helpful assistant.',
            userPrompt: 'Explain MFA in one sentence.',
            temperature: 0.7,
        });

        console.log('✅ Streaming started:');
        process.stdout.write('   Response: ');

        for await (const chunk of stream) {
            process.stdout.write(chunk);
        }

        console.log('\n   Streaming completed!');
    } catch (error: any) {
        console.error('❌ Streaming failed:', error.message);
    }
}

async function checkDatabaseSetup() {
    console.log('\n🧪 Checking Database Setup...');

    try {
        const db = await getDb();
        if (!db) {
            console.error('❌ Database connection failed');
            return;
        }

        // Check if pgvector extension exists
        const [pgvectorCheck] = await db.execute(sql`
      SELECT EXISTS (
        SELECT 1 FROM pg_extension WHERE extname = 'vector'
      ) as has_pgvector;
    `);

        console.log('✅ Database connection successful');
        console.log('   pgvector extension:', (pgvectorCheck as any).has_pgvector ? '✅ Installed' : '❌ Not installed');

        // Check embeddings table
        const [embeddingsCount] = await db.execute(sql`
      SELECT COUNT(*) as count FROM embeddings;
    `);

        console.log('   Embeddings count:', (embeddingsCount as any).count);

        // Check AI usage metrics
        const [metricsCount] = await db.execute(sql`
      SELECT COUNT(*) as count FROM ai_usage_metrics;
    `);

        console.log('   AI usage metrics:', (metricsCount as any).count);

    } catch (error: any) {
        console.error('❌ Database check failed:', error.message);
    }
}

// Run all tests
async function runAllTests() {
    console.log('🚀 Starting AI Features Test Suite\n');
    console.log('='.repeat(60));

    await checkDatabaseSetup();
    await testLLMService();
    await testStreamingLLM();
    await testEvidenceExtraction();
    await testEvidenceSuggestions();
    await testPolicyGeneration();
    await testRAGRetrieval();
    await testQuotaLimits();

    console.log('\n' + '='.repeat(60));
    console.log('✅ Test suite completed!\n');
    process.exit(0);
}

runAllTests().catch((error) => {
    console.error('\n❌ Test suite failed:', error);
    process.exit(1);
});
