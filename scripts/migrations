
import 'dotenv/config';
import { getDb } from '../db';
import { sql } from 'drizzle-orm';

async function runMigration() {
    console.log('🚀 Running schema migration for supports_embeddings...');

    try {
        const db = await getDb();
        if (!db) {
            throw new Error('Database connection failed');
        }

        // Add column if not exists
        await db.execute(sql`
            ALTER TABLE llm_providers 
            ADD COLUMN IF NOT EXISTS supports_embeddings boolean DEFAULT false;
        `);

        console.log('✅ Added supports_embeddings column');

        // Update existing providers
        // Set OpenAI to true by default
        await db.execute(sql`
            UPDATE llm_providers 
            SET supports_embeddings = true 
            WHERE provider = 'openai' OR provider = 'azure' OR provider = 'openrouter'; 
        `);

        console.log('✅ Updated default values for known providers');
        console.log('🎉 Migration completed successfully!');

    } catch (error: any) {
        console.error('\n❌ Migration failed:', error.message);
        process.exit(1);
    }
}

runMigration();
