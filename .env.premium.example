# ──────────────────────────────────────────────────────────
# GRCompliance — Premium Environment Variables
# ──────────────────────────────────────────────────────────
# Copy to .env and customize:
#   cp .env.premium.example .env
#
# All variables have safe defaults — the stack works without
# changing anything for local demo/testing.

# ── Core (required) ──────────────────────────────────────
COMPLIANCE_ADMIN_EMAIL=admin@complianceos.local
COMPLIANCE_ADMIN_PASSWORD=Admin@ComplianceOS1

# ── Wazuh SIEM ──────────────────────────────────────────
# Password for Wazuh indexer admin user
WAZUH_INDEXER_PASSWORD=wazuh

# ── TheHive + Cortex ────────────────────────────────────
# PostgreSQL password for TheHive database
THEHIVE_DB_PASSWORD=thehive
# Cortex API key (generate after first Cortex start)
CORTEX_API_KEY=

# ── Neo4j Knowledge Graph ───────────────────────────────
# Neo4j password (user is always 'neo4j')
NEO4J_PASSWORD=knowledge123

# ── Grafana ─────────────────────────────────────────────
GRAFANA_PASSWORD=complianceos

# ── DeepSeek (for RAG server LLM fallback) ──────────────
DEEPSEEK_API_KEY=
