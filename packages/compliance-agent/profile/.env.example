# Compliance Agent — .env Template

# LLM Provider
DEEPSEEK_API_KEY=

# GRCompliance API
COMPLIANCE_API_URL=http://complianceos:3002/api/v1
COMPLIANCE_API_KEY=

# Gateway (optional — set to enable Telegram/Slack)
GATEWAY_ENABLED=false
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# CISOvault bridge (optional)
CISOVAULT_API_URL=
CISOVAULT_API_KEY=

# Telemetry
NO_TELEMETRY=true

# Admin notification email
CISO_EMAIL=
