# ComplianceOS Docker self-host configuration

# App
NODE_ENV=production
VITE_ENABLE_PREMIUM=true
PORT=3001

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/complianceos

# Optional: Supabase auth
# VITE_SUPABASE_URL=https://placeholder.supabase.co
# VITE_SUPABASE_ANON_KEY=placeholder
# SUPABASE_SERVICE_ROLE_KEY=placeholder

# Optional: AI providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: Email
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
